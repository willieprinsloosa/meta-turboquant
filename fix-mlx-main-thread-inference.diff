+# Work queue: handler threads submit callables here; the main thread runs them.
+# MLX Metal callbacks require the main thread's PyThreadState — running inference
+# on daemon handler threads causes a fatal GIL crash on Python 3.13.
+_inference_queue: "_queue_module.Queue[tuple]" = _queue_module.Queue(maxsize=0)
+_inference_lock = threading.Lock()  # still used for 503-on-busy serialisation
+
+
+def _dispatch_inference(fn, *args, **kwargs):
+    """Submit fn(*args, **kwargs) to the main thread; block until result is ready.
+
+    Raises RuntimeError('server busy') if another inference is already pending.
+    Raises RuntimeError('inference timeout') on timeout.
+    Re-raises any exception thrown by fn.
+    """
+    done = threading.Event()
+    box: list = [None, None]  # [result, exception]
+
+    def _work():
+        try:
+            box[0] = fn(*args, **kwargs)
+        except Exception as exc:
+            box[1] = exc
+        finally:
+            done.set()
+
+    _inference_queue.put(_work)
+    if not done.wait(timeout=LOCK_TIMEOUT):
+        raise RuntimeError("inference timeout")
+    if box[1] is not None:
+        raise box[1]
+    return box[0]
+
+
+def _dispatch_stream(messages, max_tokens, temperature, model_id, tools=None, stop=None):
+    """Submit streaming inference to main thread; return a token queue.
+
+    Yields ('chunk', text), ('done', None), or ('error', exc) items.
+    """
+    token_q: "_queue_module.Queue[tuple]" = _queue_module.Queue()
+
+    def _work():
+        try:
+            for chunk in generate(messages, max_tokens, temperature,
+                                  stream=True, tools=None, stop=stop):
+                token_q.put(('chunk', chunk))
+            token_q.put(('done', None))
+        except Exception as exc:
+            token_q.put(('error', exc))
+
+    _inference_queue.put(_work)
+    return token_q
 
 
